//   crs: tmfProj.crs().getInfo(),
//   scale: tmfProj.nominalScale().getInfo(),
//   region: country.geometry().bounds(),
//   maxPixels: 1e12
// });

var chirpsProj = chirps.first().projection().getInfo();
Export.image.toDrive({
  image: pptAnnualMean,
  description: "ppt_mean_" + COUNTRY_FILENAME,
  folder: "deforestation_counterfactuals",
  crs: chirpsProj.crs,
  crsTransform: chirpsProj.transform,
  region: country.geometry().bounds(),
  maxPixels: 1e12
});

var era5Proj = era5.first().projection().getInfo();
Export.image.toDrive({
  image: tMean,
  description: "tMean_" + COUNTRY_FILENAME,
  folder: "deforestation_counterfactuals",
  crs: era5Proj.crs,
  crsTransform: era5Proj.transform,
  region: country.geometry().bounds(),
  maxPixels: 1e12
});

var croplandProj = cropland.first().projection().getInfo();
Export.image.toDrive({
  image: cropland.mosaic(),
  description: "cropland_" + COUNTRY_FILENAME,
  folder: "deforestation_counterfactuals",
  crs: croplandProj.crs,
  crsTransform: croplandProj.transform,
  region: country.geometry().bounds(),
  maxPixels: 1e12
});

Export.table.toDrive({
  collection: pas_country,
  description: "PAs_" + COUNTRY_FILENAME,
  folder: "deforestation_counterfactuals",
  fileFormat: "GeoJSON"
});